  "repository": {
    "developmentRef": "dev/v0/v0.1",
    "pullRequestTarget": "dev/v0/v0.1"
  },
  "commands": {
    "verify": "pnpm paper:agent:verify",
    "start": "pnpm paper:work:start -- <topic> --execute --json",
